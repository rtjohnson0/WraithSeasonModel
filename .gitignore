.env
# Downloaded data and trained models stay out of git. The pick log, graded results and calibration
# are the record of the project, so those three are kept (git add -f works around the rule below).
data/*
!data/picklog.jsonl
!data/settled.jsonl
!data/calibration.json
!data/model.json
!data/gamecal.json
!data/biasfix.json
!data/minfix.json
!data/wofix.json
!data/runs.jsonl
!data/more.json
!data/projlog.jsonl
!data/combolog.jsonl
!data/combosettled.jsonl
!data/combocorr.json
!data/lines
demo_data/
bin/
*.exe
site/node_modules/
site/dist/
