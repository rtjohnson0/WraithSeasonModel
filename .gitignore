.env
# Downloaded data and trained models stay out of git. The pick log, graded results and calibration
# are the record of the project, so those three are kept (git add -f works around the rule below).
data/*
!data/picklog.jsonl
!data/settled.jsonl
!data/calibration.json
!data/model.json
!data/gamecal.json
!data/biasfix.json
!data/minfix.json
!data/wofix.json
!data/runs.jsonl
!data/more.json
!data/projlog.jsonl
!data/combolog.jsonl
!data/combosettled.jsonl
!data/combocorr.json
!data/lines
!data/v2log.jsonl
!data/v2settled.jsonl
!data/v2.json
!data/model_v2.json
demo_data/
bin/
*.exe
site/node_modules/
site/dist/
!data/combocalibration.json
!data/exclusions.jsonl
# Exact input/model replay captures are retained as workflow artifacts, not committed.
__pycache__/
*.pyc

!data/board.json

!data/gameboard.json

!data/quarterboard.json
!data/quarterlog.jsonl
!data/quarter_games/
