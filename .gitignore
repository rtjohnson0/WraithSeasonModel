.env
# Downloaded data and trained models stay out of git. The pick log, graded results and calibration
# are the record of the project, so those three are kept (git add -f works around the rule below).
data/*
!data/picklog.jsonl
!data/settled.jsonl
!data/calibration.json
!data/model.json
!data/gamecal.json
!data/biasfix.json
!data/minfix.json
!data/wofix.json
!data/runs.jsonl
!data/more.json
!data/projlog.jsonl
!data/combolog.jsonl
!data/combosettled.jsonl
!data/combocorr.json
!data/lines
!data/v2log.jsonl
!data/v2settled.jsonl
!data/v2_rotationlog.jsonl
!data/v2_rotationsettled.jsonl
!data/v2_rotationsettled_audit.json
!data/v2.json
!data/model_v2.json
demo_data/
bin/
*.exe
site/node_modules/
site/dist/
!data/combocalibration.json
!data/exclusions.jsonl
# Exact input/model replay captures are retained as workflow artifacts, not committed.
__pycache__/
*.pyc

!data/board.json

!data/gameboard.json

!data/quarterboard.json
!data/quarterlog.jsonl
!data/quarter_games/

!data/settled_audit.json
!data/combosettled_audit.json
!data/v2settled_audit.json
!data/side_audit.json
# Local audit evidence and recovery bundle; keep it out of source pushes.
audit_findings/

!data/accuracy.json

# Isolated comparison runs and frozen experimental bundles.
/research/

run_evidence/
forecast_audit/

!data/model_tail.json
!data/calibration_tail.json

/private/
/server/.env
.venv/

!data/gamepicklog.jsonl
!data/gamesettled.jsonl
!data/combohealth.json

!data/gamecal_research.json
!data/v2_gamepicklog.jsonl
!data/v2_gamesettled.jsonl
!data/v2_rotation_strictlog.jsonl
!data/v2_rotation_strictsettled.jsonl

!data/model_refresh.json
# Aggregate-only V2.1 lab evidence; no player/odds/line-level inputs.
!data/v21_lab.json

!data/v2_rotation_fallbacklog.jsonl
!data/v2_rotation_fallbacksettled.jsonl

